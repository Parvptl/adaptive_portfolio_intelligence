# Copy to `.env` and fill in locally. NEVER commit `.env`.
# Placeholders only. No data provider has been selected or validated yet;
# these keys exist so that future data loaders have a documented place to read
# credentials from. CI and the test suite must not depend on any of them.

# Optional market-data provider credentials (provisional; fill only if needed).
MARKET_DATA_API_KEY=your-api-key-here

# Override default local directories (optional).
ADAPTIVE_PORTFOLIO_DATA_DIR=./data
ADAPTIVE_PORTFOLIO_REPORTS_DIR=./reports
